get_filename_component(clf-utils_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

if(NOT TARGET clf-utils)
    include("${clf-utils_CMAKE_DIR}/clf-utils-targets.cmake")
endif()

set(clf-utils_LIBRARIES clf-utils)
set(clf-utils_VERSION @PROJECT_VERSION@)
set(clf-utils_FOUND TRUE)

message(STATUS "Found clf-utils: clf-utils_LIBRARIES: ${clf-utils_LIBRARIES} (version ${clf-utils_VERSION})")