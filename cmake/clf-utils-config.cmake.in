@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)

if(NOT TARGET clf-utils::clf-utils)
    include("${CMAKE_CURRENT_LIST_DIR}/clf-utils-targets.cmake")
endif()

set(clf-utils_LIBRARIES clf-utils::clf-utils)
set(clf-utils_VERSION "@PROJECT_VERSION@")

check_required_components("clf-utils")
